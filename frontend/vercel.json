{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cms-api.pixelspringmarketing.com/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://cms-api.pixelspringmarketing.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
