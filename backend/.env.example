# --- App ---
NODE_ENV=development
PORT=4000
DASHBOARD_URL=http://localhost:3000

# --- Database — required (API, Prisma, and the realtime Postgres LISTEN bridge all need this) ---
DATABASE_URL=postgresql://dvine:dvine@localhost:5432/dvine_spa

# --- Clerk — required for /admin/* auth, webhooks, and Socket.IO handshake auth ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# --- Redis (only needed once scaling past one instance, see API docs §12.6) ---
REDIS_URL=
