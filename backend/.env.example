# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (already in .gitignore)

# ============================================================================
# Node Environment & Server
# ============================================================================
NODE_ENV=development
PORT=4000

# ============================================================================
# Database Configuration
# ============================================================================
# Format: postgresql://username:password@hostname:port/database
# For Docker Compose: postgres://postgres:postgres_dev_password@postgres:5432/dvine_spa
DATABASE_URL=postgresql://postgres:postgres_dev_password@postgres:5432/dvine_spa

# PostgreSQL Docker Compose variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=dvine_spa
POSTGRES_PORT=5432

# ============================================================================
# Clerk Authentication (Optional - Phase 1)
# ============================================================================
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_dYMlmafbTF8afX7K4DJTUHx9MbCpZxAQhZqua4YpU9
CLERK_PUBLISHABLE_KEY=pk_test_ZGl2ZXJzZS1wYW5nb2xpbi02NS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_WEBHOOK_SECRET=whsec_J9d/niIz56JJwb73QI0Ta1s5viefke77

# ============================================================================
# Frontend Dashboard
# ============================================================================
DASHBOARD_URL=http://localhost:3000

# ============================================================================
# Redis (Optional - for caching)
# ============================================================================
REDIS_URL=

# ============================================================================
# Email — SendGrid (Optional in dev; required in production for notifications)
# ============================================================================
# When SENDGRID_API_KEY is unset, all email sends are silently skipped with
# a warning log — the app boots and works identically to before.
#
# 1. Create a free account at https://sendgrid.com
# 2. Verify a Sender Identity (single sender or domain) — this becomes SENDGRID_FROM_EMAIL
# 3. Generate an API key with "Mail Send" permission only
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=bookings@dvinespa.rw
SENDGRID_FROM_NAME=d'Vine Spa

# Public-facing website origin (used in email links).
# Separate from DASHBOARD_URL which is the *admin* dashboard origin used for CORS.
FRONTEND_URL=https://dvinespa.rw

# Google Business Profile (or other platform) review link.
# Dropped into the "booking completed" thank-you email as a CTA button.
# If unset, the template renders without the review CTA — doesn't block shipping.
REVIEW_LINK_URL=

# ============================================================================
# Deployment Notes
# ============================================================================
# Production:
#   - Set NODE_ENV=production
#   - Use strong PostgreSQL passwords
#   - Set real Clerk credentials if needed
#   - Configure proper DATABASE_URL for production database
#   - Set DASHBOARD_URL to your production frontend URL
#
# Local Development:
#   - Use docker-compose up to spin up local PostgreSQL
#   - DATABASE_URL will be auto-configured from docker-compose
#   - See docker-compose.yml for all available service configuration
