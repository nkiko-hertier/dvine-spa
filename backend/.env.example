# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=4444
DASHBOARD_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# When running via docker compose, the host is "postgres" (service name).
# For local development outside Docker, use localhost:5432.
DATABASE_URL=postgresql://dvine:dvine@postgres:5432/dvine_spa

# ── Clerk — required for /admin/* auth, webhooks, and Socket.IO ──
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── Redis — only needed when scaling past one instance ───────
REDIS_URL=
