{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --config.dangerously-allow-all-builds=true",
  "buildCommand": "pnpm run vercel-build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/attention?summary=1",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/internal/cron/attention",
      "schedule": "0 9,12,15,18 * * *"
    }
  ]
}
